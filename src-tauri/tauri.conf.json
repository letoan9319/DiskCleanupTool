{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskCleanupTool",
  "version": "0.3.0",
  "identifier": "com.letoan.diskcleanuptool",
  "mainBinaryName": "DiskCleanupTool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiskCleanupTool",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Le Toan",
    "copyright": "Copyright (c) 2026 Le Toan",
    "category": "Utility",
    "shortDescription": "Fast Windows disk space analyzer, S.M.A.R.T. health monitor, and safe cleanup tool",
    "longDescription": "DiskCleanupTool analyzes Windows disk usage with high-speed NTFS MFT and parallel Win32 scanning, interactive Treemaps, duplicate detection, and native S.M.A.R.T. drive health monitoring.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": [
          "English",
          "Vietnamese",
          "SimpChinese",
          "Japanese",
          "Korean",
          "Spanish",
          "German",
          "French"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "./installer/hooks.nsh",
        "compression": "zlib"
      }
    }
  }
}
